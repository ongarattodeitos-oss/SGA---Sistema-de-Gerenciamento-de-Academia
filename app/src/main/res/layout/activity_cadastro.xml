<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FOTO DE FUNDO -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/cadastrobackground"
        android:scaleType="centerCrop" />

    <!-- OVERLAY ESCURO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

        <!-- CARD GLASS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="90dp"
            android:layout_marginBottom="90dp"
            android:background="@drawable/bg_glass"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ============================= -->
            <!-- CABEÇALHO -->
            <!-- ============================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar Conta"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Preencha os dados para começar"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <!-- ============================= -->
            <!-- NOME -->
            <!-- ============================= -->

            <EditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edit"
                android:hint="Nome Completo"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp" />

            <!-- ============================= -->
            <!-- EMAIL -->
            <!-- ============================= -->

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp" />

            <!-- ============================= -->
            <!-- TELEFONE -->
            <!-- ============================= -->

            <EditText
                android:id="@+id/edtTelefone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="Telefone"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp" />

            <!-- ============================= -->
            <!-- CPF + DATA -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtCpf"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:hint="CPF"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtNascimento"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:hint="Data Nasc."
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ============================= -->
            <!-- USUÁRIO -->
            <!-- ============================= -->

            <EditText
                android:id="@+id/edtUsuario"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit"
                android:hint="Usuário"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp" />

            <!-- ============================= -->
            <!-- SENHA + CONFIRMAR -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:hint="Senha"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtConfirmarSenha"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:hint="Confirmar"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ============================= -->
            <!-- BOTÃO CADASTRAR -->
            <!-- ============================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:padding="0dp"
                android:text="CADASTRAR"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ============================= -->
            <!-- VOLTAR PARA LOGIN -->
            <!-- ============================= -->

            <TextView
                android:id="@+id/txtLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="Já possui uma conta? Entrar"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

</FrameLayout>