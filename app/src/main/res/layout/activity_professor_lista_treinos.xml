<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B12">

    <!-- ================================================= -->
    <!-- CONTEÚDO -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp"
            android:background="#0B0B0C">

            <!-- ================================================= -->
            <!-- CABEÇALHO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloTreinos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Treinos"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/txtSubtituloTreinos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Monte e gerencie as fichas de treino dos seus alunos."
                android:textColor="#8E9AAF"
                android:textSize="15sp" />

            <!-- LINHA DECORATIVA -->

            <View
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="#03C6FC" />


            <!-- ================================================= -->
            <!-- CARD RESUMO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_card_professor"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALUNOS COM TREINOS"
                    android:textColor="#7F8CA3"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtQuantidadeAlunosTreino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="0"
                    android:textColor="#03C6FC"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatusListaTreino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Carregando alunos..."
                    android:textColor="#657086"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ÁREA DE SELEÇÃO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Selecione um aluno"
                android:textColor="#03C6FC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />


            <!-- ================================================= -->
            <!-- PESQUISA -->
            <!-- ================================================= -->

            <EditText
                android:id="@+id/edtPesquisarAlunoTreino"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_professor"
                android:hint="Buscar por nome ou usuário..."
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#657086"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="text"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp" />


            <!-- ================================================= -->
            <!-- LISTA -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/containerAlunosTreino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />


            <!-- ================================================= -->
            <!-- NENHUM ALUNO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardNenhumAlunoTreino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_professor"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="30dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum aluno encontrado"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Tente pesquisar usando outro nome ou usuário."
                    android:textColor="#707D92"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- MENU INFERIOR -->
    <!-- ================================================= -->

    <include
        android:id="@+id/menuProfessor"
        layout="@layout/menu_professor" />

</LinearLayout>