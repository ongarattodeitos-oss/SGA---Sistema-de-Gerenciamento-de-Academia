<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

                <!-- ========================================== -->
                <!-- TÍTULO -->
                <!-- ========================================== -->

                <TextView
                    android:id="@+id/txtTituloPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MEU PERFIL"
                    android:textColor="@color/ciano_sga"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp" />


                <!-- ========================================== -->
                <!-- CARTÃO DO PERFIL -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="22dp"
                    android:background="@drawable/bg_card_perfil">

                        <!-- FOTO -->

                        <ImageView
                            android:id="@+id/imgPerfil"
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_launcher_foreground"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_foto_perfil"
                            android:padding="3dp"
                            android:clipToOutline="true"
                            android:contentDescription="Foto de perfil" />

                        <!-- ESPAÇO -->

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="12dp" />


                        <!-- NOME -->

                        <TextView
                            android:id="@+id/txtNomeCompleto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end" />


                        <!-- USUÁRIO -->

                        <TextView
                            android:id="@+id/txtNomeUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@color/cinza_sga"
                            android:textSize="15sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />


                        <!-- BOTÃO FOTO -->

                        <Button
                            android:id="@+id/btnAlterarFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALTERAR FOTO"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp" />

                </LinearLayout>


                <!-- ========================================== -->
                <!-- ESPAÇO -->
                <!-- ========================================== -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />


                <!-- ========================================== -->
                <!-- INFORMAÇÕES PESSOAIS -->
                <!-- ========================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INFORMAÇÕES PESSOAIS"
                    android:textColor="@color/ciano_sga"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />


                <!-- ========================================== -->
                <!-- EMAIL -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_info_perfil"
                    android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="E-MAIL"
                            android:textColor="@color/cinza_sga"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:layout_marginTop="4dp" />

                </LinearLayout>


                <!-- ========================================== -->
                <!-- TELEFONE -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_info_perfil"
                    android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TELEFONE"
                            android:textColor="@color/cinza_sga"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtTelefone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:layout_marginTop="4dp" />

                </LinearLayout>


                <!-- ========================================== -->
                <!-- CPF -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_info_perfil"
                    android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CPF"
                            android:textColor="@color/cinza_sga"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCpf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:layout_marginTop="4dp" />

                </LinearLayout>


                <!-- ========================================== -->
                <!-- DATA DE NASCIMENTO -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_info_perfil"
                    android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="DATA DE NASCIMENTO"
                            android:textColor="@color/cinza_sga"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:layout_marginTop="4dp" />

                </LinearLayout>


                <!-- ========================================== -->
                <!-- DADOS FÍSICOS -->
                <!-- ========================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DADOS FÍSICOS"
                    android:textColor="@color/ciano_sga"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />


                <!-- ========================================== -->
                <!-- PESO -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_info_perfil"
                    android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PESO"
                            android:textColor="@color/cinza_sga"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:layout_marginTop="4dp" />

                </LinearLayout>


                <!-- ========================================== -->
                <!-- ALTURA -->
                <!-- ========================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_info_perfil"
                    android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ALTURA"
                            android:textColor="@color/cinza_sga"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtAltura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Carregando..."
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:layout_marginTop="4dp" />

                </LinearLayout>

        </LinearLayout>

</ScrollView>