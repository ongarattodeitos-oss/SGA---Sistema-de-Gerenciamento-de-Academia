<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERFIL"
            android:textColor="@color/ciano_sga"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>


        <!-- FOTO -->

        <ImageView
            android:id="@+id/imgPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:layout_marginBottom="12dp"/>


        <!-- BOTÃO FOTO -->

        <Button
            android:id="@+id/btnAlterarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ALTERAR FOTO"
            android:textColor="@android:color/white"
            android:layout_marginBottom="30dp"/>


        <!-- NOME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtNomeCompleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- USUÁRIO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome de usuário"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtNomeUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- EMAIL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- TELEFONE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- CPF -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CPF"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtCpf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- DATA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data de nascimento"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- PESO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peso"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>


        <!-- ALTURA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Altura"
            android:textColor="@color/cinza_sga"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtAltura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp"/>

    </LinearLayout>



</ScrollView>
