<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B12">


    <!-- ================================================= -->
    <!-- CONTEÚDO -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ========================================= -->
            <!-- CABEÇALHO -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtTituloOpcao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TREINOS"
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.03" />

            <TextView
                android:id="@+id/txtSubtituloOpcao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Acompanhe seus exercícios e treinos."
                android:textSize="14sp"
                android:textColor="#8E9AAF" />


            <!-- LINHA FUTURISTA -->

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginTop="15dp"
                android:background="#2df733" />


            <!-- ========================================= -->
            <!-- CARD DE DESTAQUE -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="20dp"
                android:background="#111722">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SGA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#2df733"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Seu desempenho.\nSua evolução."
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tudo em um só lugar."
                    android:textSize="13sp"
                    android:textColor="#707D92" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- ÁREA DE CONTEÚDO -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="VISÃO GERAL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#657086"
                android:letterSpacing="0.12" />


            <!-- CARD 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="#111722">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="◈"
                    android:textSize="25sp"
                    android:textColor="#2df733" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treino atual"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Consulte seus exercícios"
                        android:textSize="12sp"
                        android:textColor="#707D92" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#2df733" />

            </LinearLayout>


            <!-- CARD 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="#111722">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="◇"
                    android:textSize="27sp"
                    android:textColor="#2df733" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seu plano"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Acompanhe sua evolução"
                        android:textSize="12sp"
                        android:textColor="#707D92" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#2df733" />

            </LinearLayout>


            <!-- CARD 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="#111722">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="◎"
                    android:textSize="27sp"
                    android:textColor="#2df733" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meu perfil"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Informações da sua conta"
                        android:textSize="12sp"
                        android:textColor="#707D92" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#2df733" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <include
        android:id="@+id/menuAluno"
        layout="@layout/menu_aluno" />

</LinearLayout>