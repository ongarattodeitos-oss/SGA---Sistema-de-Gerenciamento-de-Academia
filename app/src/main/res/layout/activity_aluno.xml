<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B12">

    <!-- ================================================= -->
    <!-- CONTEÚDO -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ========================================= -->
            <!-- CABEÇALHO -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/txtSaudacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Olá, aluno!"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Acompanhe seus dados e seu progresso."
                android:textSize="15sp"
                android:textColor="#8E9AAF" />

            <!-- LINHA DECORATIVA -->

            <View
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="#2DF733" />


            <!-- ========================================= -->
            <!-- DADOS FÍSICOS -->
            <!-- ========================================= -->

            <LinearLayout
                android:id="@+id/cardDadosFisicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card_professor">

                <!-- TÍTULO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DADOS FÍSICOS"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2DF733"
                    android:letterSpacing="0.12" />

                <!-- DESCRIÇÃO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Informe seus dados para acompanhar seu IMC."
                    android:textSize="13sp"
                    android:textColor="#707D92" />


                <!-- ===================================== -->
                <!-- PESO -->
                <!-- ===================================== -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="PESO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7F8CA3"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#101722">

                    <EditText
                        android:id="@+id/edtPeso"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Ex.: 70,0"
                        android:inputType="numberDecimal"
                        android:paddingStart="15dp"
                        android:paddingEnd="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#536074"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="15dp"
                        android:text="kg"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2DF733" />

                </LinearLayout>


                <!-- ===================================== -->
                <!-- ALTURA -->
                <!-- ===================================== -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="ALTURA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7F8CA3"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#101722">

                    <EditText
                        android:id="@+id/edtAltura"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Ex.: 1,75"
                        android:inputType="numberDecimal"
                        android:paddingStart="15dp"
                        android:paddingEnd="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#536074"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="15dp"
                        android:text="m"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2DF733" />

                </LinearLayout>


                <!-- ===================================== -->
                <!-- IMC -->
                <!-- ===================================== -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#202938" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IMC"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#7F8CA3"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Calculado automaticamente"
                            android:textSize="12sp"
                            android:textColor="#657086" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtIMC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="#2DF733" />

                </LinearLayout>


                <!-- ===================================== -->
                <!-- STATUS DO IMC -->
                <!-- ===================================== -->

                <TextView
                    android:id="@+id/txtClassificacaoIMC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Informe peso e altura para calcular."
                    android:textSize="12sp"
                    android:textColor="#707D92" />


                <!-- ===================================== -->
                <!-- BOTÃO SALVAR -->
                <!-- ===================================== -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalvarDadosFisicos"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:text="SALVAR DADOS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#080B12"
                    android:backgroundTint="#2DF733"
                    android:padding="0dp" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- STATUS -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_professor">

                <View
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#35E88A" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="STATUS  •  ALUNO ATIVO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#35E88A"
                    android:letterSpacing="0.06" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- MINHA META -->
            <!-- ========================================= -->

            <LinearLayout
                android:id="@+id/cardMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card_professor">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINHA META"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2DF733"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/txtMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Nenhuma meta definida"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Defina um objetivo e acompanhe sua evolução."
                    android:textSize="13sp"
                    android:textColor="#707D92" />

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="18dp"
                    android:progress="0"
                    android:max="100"
                    android:indeterminate="false"
                    android:progressTint="#2DF733"
                    android:backgroundTint="#202938" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNovaMeta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="+  DEFINIR NOVA META"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#080B12"
                    android:backgroundTint="#2DF733"
                    android:padding="0dp" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- DOCUMENTOS MÉDICOS -->
            <!-- ========================================= -->

            <LinearLayout
                android:id="@+id/cardDocumentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card_professor">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOCUMENTOS MÉDICOS"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2DF733"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▣"
                        android:textSize="25sp"
                        android:textColor="#2DF733" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exames e laudos"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Envie documentos importantes para sua avaliação."
                            android:textSize="12sp"
                            android:textColor="#707D92" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:padding="13dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#0E1717">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="#2DF733" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Informe exames, laudos ou restrições médicas."
                        android:textSize="12sp"
                        android:textColor="#8E9AAF" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtNenhumDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Nenhum documento anexado."
                    android:textSize="13sp"
                    android:textColor="#657086" />

                <LinearLayout
                    android:id="@+id/listaExames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtNomeDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Nenhum arquivo selecionado"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/txtTipoDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tipo: --"
                    android:textSize="12sp"
                    android:textColor="#2DF733" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAnexarDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="+  ANEXAR EXAME OU LAUDO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#080B12"
                    android:backgroundTint="#2DF733"
                    android:padding="0dp" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- TREINO ATUAL -->
            <!-- ========================================= -->

            <LinearLayout
                android:id="@+id/cardTreino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card_professor">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TREINO ATUAL"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2DF733"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/txtNomeTreino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Nenhum treino selecionado"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/txtDescricaoTreino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Seu treino aparecerá aqui."
                    android:textSize="13sp"
                    android:textColor="#707D92" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVerTreino"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:text="VER TREINO  →"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#182334"
                    android:padding="0dp" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- DEFINIR TREINO -->
            <!-- ========================================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNovoTreino"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="+  DEFINIR TREINO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2DF733"
                android:backgroundTint="#101923"
                android:padding="0dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- MENU INFERIOR -->
    <!-- ================================================= -->

    <include
        android:id="@+id/menuAluno"
        layout="@layout/menu_aluno" />

</LinearLayout>