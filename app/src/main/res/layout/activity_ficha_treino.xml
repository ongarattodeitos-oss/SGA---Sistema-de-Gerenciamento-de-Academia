<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B12">

    <!-- ===================================================== -->
    <!-- CONTEÚDO -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ================================================= -->
            <!-- TOPO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnVoltarFicha"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fichas de treino"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtSubtituloFicha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Gerencie os treinos do aluno"
                        android:textColor="#8B95A7"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- LINHA CYAN -->
            <!-- ================================================= -->

            <View
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="18dp"
                android:background="#03C6FC"/>


            <!-- ================================================= -->
            <!-- ALUNO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:padding="18dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_professor">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALUNO"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtNomeAlunoFicha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Nome do aluno"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtUsuarioAlunoFicha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="usuario"
                    android:textColor="#03C6FC"
                    android:textSize="14sp"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RESUMO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_weight="1"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_professor">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FICHAS"
                        android:textColor="#657086"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtQuantidadeFichas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="0"
                        android:textColor="#03C6FC"
                        android:textSize="28sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_weight="1"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_professor">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATUS"
                        android:textColor="#657086"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtStatusFichas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Carregando..."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BOTÃO NOVA FICHA -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/btnNovaFicha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="+  NOVA FICHA"
                android:textColor="#080B12"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_professor"
                android:clickable="true"
                android:focusable="true"/>


            <!-- ================================================= -->
            <!-- TÍTULO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloFichas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Fichas do aluno"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtStatusListaFichas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Buscando fichas..."
                android:textColor="#657086"
                android:textSize="13sp"/>


            <!-- ================================================= -->
            <!-- LISTA -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/containerFichas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>


            <!-- ================================================= -->
            <!-- VAZIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardNenhumaFicha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_professor"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="25dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Nenhuma ficha Encontrada"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Crie a primeira ficha de treino para este aluno."
                    android:textColor="#657086"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>