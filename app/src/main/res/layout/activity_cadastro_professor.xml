<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080B12">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0B0B0C"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- VOLTAR -->

            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="9dp"
                android:backgroundTint="#182334"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="← Voltar"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- CABEÇALHO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PROFESSORES"
                android:textColor="#03C6FC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cadastrar professor"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Preencha os dados para adicionar um novo professor"
                android:textColor="#8E9AAF"
                android:textSize="14sp" />

            <!-- CARD DADOS PESSOAIS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card_professor"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DADOS PESSOAIS"
                    android:textColor="#03C6FC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- NOME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="NOME COMPLETO"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNome"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="Digite o nome completo"
                    android:singleLine="true" />

                <!-- TELEFONE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="TELEFONE"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="(00) 00000-0000"
                    android:singleLine="true" />

                <!-- CPF -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="CPF"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCpf"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="000.000.000-00"
                    android:singleLine="true" />

                <!-- SALÁRIO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="SALÁRIO"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtSalario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="0,00"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- CARD ACESSO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_professor"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DADOS DE ACESSO"
                    android:textColor="#03C6FC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- USUÁRIO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="USUÁRIO"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="Nome de usuário"
                    android:singleLine="true" />

                <!-- E-MAIL -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="E-MAIL"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="email@exemplo.com"
                    android:singleLine="true" />

                <!-- SENHA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="SENHA"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="Crie uma senha"
                    android:singleLine="true" />

                <!-- CONFIRMAR SENHA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="CONFIRMAR SENHA"
                    android:textColor="#657086"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtConfirmarSenha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_professor"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#657086"
                    android:textSize="15sp"
                    android:hint="Repita a senha" />

            </LinearLayout>

            <!-- CADASTRAR -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_professor"
                android:text="CADASTRAR PROFESSOR"
                android:textColor="#080B12"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>